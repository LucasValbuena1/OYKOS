# ---------------------------------------------------------------
# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube al repositorio (está en .gitignore).
# ---------------------------------------------------------------

# ---------- Auth0 (seguridad: registro, login, MFA, contraseñas) ----------
# Dominio del tenant, SIN https://  (ej: oykos-dev.us.auth0.com)
AUTH0_DOMAIN=
# Credenciales de la aplicación "Regular Web Application" en Auth0
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Secreto para cifrar la cookie de sesión: genera uno con  openssl rand -hex 32
AUTH0_SECRET=
# URL donde corre la app (local o Docker)
APP_BASE_URL=http://localhost:3000
# Conexión de usuario/contraseña de Auth0 (por defecto la estándar)
AUTH0_DB_CONNECTION=Username-Password-Authentication

# ---------- Claude (IA: asistente y escáner de recibos) ----------
# API key de https://console.anthropic.com (solo la usa el servidor)
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Opcional: modelo para elegir el link de pago (por defecto claude-haiku-4-5-20251001)
ANTHROPIC_LINK_MODEL=
